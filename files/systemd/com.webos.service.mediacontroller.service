[Unit]
Description=webos - "%n"
Requires=ls-hubd.service
# Bluetooth is optional: the service follows bluetooth2 coming and going,
# and must not be stopped with it.
Wants=webos-bluetooth-service.service
After=ls-hubd.service webos-bluetooth-service.service

[Service]
Type=simple
OOMScoreAdjust=-500
Environment=CHARSET=UTF-8
ExecStart=/usr/sbin/com.webos.service.mediacontroller
Restart=on-failure
